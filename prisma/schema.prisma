// popsmosis — droplets for learning.
//
// Humans sign in with Google (any Google account) and get a session cookie,
// then ask for a topic to learn. Agents authenticate with a bearer API key that
// is stored only as a sha256 hash. Each request (a Question) gets exactly one
// lesson (its Answer); follow-ups under a lesson form a linear human <-> agent
// thread.

generator client {
  provider = "prisma-client"
  output   = "../api/src/generated/prisma"
  // A partial index for the Clips feed (answers_clips_idx).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum QuestionStatus {
  PENDING // no answer yet
  ANSWERED // the one answer exists
  FAILED // the agent gave up before a lesson passed its fact-check; failedReason says why
}

// The droplet's two videos (docs/PLAN.md, section 10). Null on the answer: a text-only droplet.
enum VideoStatus {
  RENDERING
  READY
  FAILED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  googleId  String   @unique
  name      String?
  avatarUrl String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The record of agreeing to the Terms of Use and Privacy Policy (api/src/lib/terms.ts): the version this person last
  // agreed to and when. Null: never, for an account made before the box existed; the web app asks at the next visit.
  termsVersion    String?
  termsAcceptedAt DateTime?

  questions       Question[]
  replies         Reply[]
  dropletLikes    DropletLike[]
  dropletComments DropletComment[]
  usageEvents     UsageEvent[]

  @@map("users")
}

enum UsageKind {
  TOPIC // a topic asked for: a droplet the studio makes, at about $0.70 to $1 of model spend
  REPLY // a follow-up, which the teacher answers
}

// What each learner has asked for lately, counted for the daily and hourly limits (api/src/lib/usage.ts). Kept apart
// from the requests on purpose: taking a request back or deleting it must not hand back what it used, or "ask, wait
// for the lesson, take it back" would never run out. Only who, what kind and when: never the words. Rows past two days
// are let go, and an account's go with it.
model UsageEvent {
  id        String    @id @default(cuid())
  userId    String
  kind      UsageKind
  bytes     Int       @default(0) // the files sent with it, for the daily byte quota on attachments
  // True from the take until its message (and so its files) is written: what is held counts these too, so two
  // messages sent at once cannot both pass it (api/src/lib/usage.ts).
  filesPending Boolean @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@index([kind, createdAt]) // the site-wide daily cap on topics
  @@index([createdAt]) // letting old rows go
  @@map("usage_events")
}

model Agent {
  id         String    @id @default(cuid())
  name       String    @unique
  apiKeyHash String?   @unique // sha256 of the raw sk_pop_ key; the raw key is never stored. NULL = revoked, no key works until an admin mints one
  enabled    Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  answers Answer[]
  replies Reply[]

  @@map("agents")
}

model Question {
  id        String         @id @default(cuid())
  // Null once the learner took it back, or deleted their account, after it had a lesson: the lesson stays (public,
  // and nothing about the learner) while their words, files and follow-ups go (lib/forget.ts).
  userId    String?
  content   String // 3..2000 chars: a topic to learn ("ATP synthesis"), or a fuller request; "" once taken back
  status    QuestionStatus @default(PENDING)
  createdAt DateTime       @default(now())

  // A short lease taken by the queue endpoint so two overlapping runs cannot be
  // handed the same question. It expires on its own: a run that dies mid-answer
  // must not hold a question out of the queue forever.
  claimedAt   DateTime?
  claimedById String? // the agent holding the lease; for the admin page and debugging

  failedReason String? // FAILED: one line on why, shown on the card

  // Where the studio is while it writes the lesson (lib/progress.ts): the steps running now, the lesson's bill so
  // far, and whether the videos' steps come after. Sent before each step (PUT /api/questions/:id/progress).
  progress Json?

  // The brain an admin picked for this topic on /learn (api/src/lib/brains.ts): claude, muse-wonder or muse-spark.
  // Null: the default brain an admin sets on /admin/studio (api/src/lib/studio-settings.ts). The studio reads both
  // from the claim.
  brain String?

  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     Answer[]
  attachments Attachment[]

  @@index([status, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("questions")
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  agentId    String
  content    String // <= 5000 chars, markdown
  model      String? // which LLM produced it, free text
  createdAt  DateTime @default(now())

  // What the studio made it from, saved with the lesson. Too big for a list of cards, so the question routes omit
  // them (lib/serialize.ts); the reply queue reads a compact context out of the bundle (lib/droplet.ts).
  bundle    Json? // bundle.json as it passed the fact-check
  factcheck Json? // factcheck.json: the verdict on every line
  // What the studio's checks found, for an admin reviewing the droplet (GET /api/answers/:id/review); omitted like the
  // two above. Null for a droplet made before they were sent.
  checks    Json? // checks.json: the code checks on the bundle, sent with the lesson
  artChecks Json? // the art checker's look at each scene's picture, every try, sent with READY (lib/review.ts)

  videoStatus     VideoStatus?
  songVideoUrl    String?
  lessonVideoUrl  String?
  songPosterUrl   String? // a still for each video, shown before it plays
  lessonPosterUrl String?
  hookVideoUrl    String? // the hook cut: the song's pre-chorus and first chorus, upright, to share
  hookPosterUrl   String?
  videoError      String? // FAILED: why, shown on the droplet
  videoUpdatedAt  DateTime? // the last status change; RENDERING for too long reads as FAILED
  hiddenAt        DateTime? // an admin took it off the public Droplets tab; null: listed once READY
  // Set when the videos became READY while /admin/studio asked for a person to look at each droplet first: not listed
  // until an admin approves it (null). Null for every droplet made without review, and for those before it.
  awaitingReviewSince DateTime?
  videoAttempts   Int          @default(0) // renders started (POST /api/answers/:id/video/claim); recovery stops at VIDEO_MAX_ATTEMPTS

  // How the droplet was made, step by step: each step's time and tries, its cost and the models that ran it
  // (studio/ledger.py, lib/breakdown.ts). Shown under the lesson on /learn.
  lessonBreakdown Json? // the steps up to the post, sent with the lesson
  videoBreakdown  Json? // the media steps: so far while they render (PUT /api/answers/:id/video/progress), then with READY
  videoProgress   Json? // the media steps running now, while they render (lib/progress.ts)

  // The Droplets tab's thumbs-up and comments, counted. Kept by triggers on droplet_likes and droplet_comments
  // (migration 20261031120000_droplet_engagement), never written by the API, so a cascade from a deleted user or a
  // hand-run DELETE keeps them exact too.
  likeCount    Int @default(0)
  commentCount Int @default(0)

  // Each video's hashtags, the way a TikTok is tagged (lib/tags.ts): the studio's brain writes them into the bundle,
  // and they are copied here, cleaned, when the lesson is posted. Shown under the videos; the Droplets tab searches by them.
  songTags   String[] @default([])
  lessonTags String[] @default([])

  question Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  agent    Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  replies  Reply[]
  likes    DropletLike[]
  comments DropletComment[]
  plays    DropletPlays[]

  @@unique([questionId, agentId]) // second guard: one answer per agent per question
  @@index([agentId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)]) // status poll: MAX(createdAt)
  @@index([videoStatus, createdAt(sort: Desc), id(sort: Desc)]) // the Droplets tab: READY, newest first
  // The Droplets tab's Clips feed (?clips=1): only droplets with a hook cut, newest first. Partial, so it holds
  // just those rows and the feed reads a page of them however few of all droplets have one.
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "answers_clips_idx", where: raw("\"hookVideoUrl\" IS NOT NULL AND \"videoStatus\" = 'READY' AND \"hiddenAt\" IS NULL"))
  @@index([songTags], type: Gin) // the Droplets tab, searched by a tag
  @@index([lessonTags], type: Gin)
  @@map("answers")
}

model Reply {
  id        String   @id @default(cuid())
  answerId  String
  userId    String? // set when a human wrote it
  agentId   String? // set when the agent wrote it
  replyToId String?  @unique // agent replies only: the human reply being answered (one agent reply per human reply)
  content   String // 1..2000 chars
  createdAt DateTime @default(now())

  answer      Answer       @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent       Agent?       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  replyTo     Reply?       @relation("AgentReplyTo", fields: [replyToId], references: [id], onDelete: Cascade)
  agentReply  Reply?       @relation("AgentReplyTo")
  attachments Attachment[]

  @@index([answerId, createdAt])
  @@index([createdAt(sort: Desc)]) // status poll: MAX(createdAt)
  @@index([userId, createdAt]) // deleting an account finds its follow-ups; the hourly follow-up limit counts them
  @@map("replies")
}

// A file a human sent with a question or a human reply (lib/attachments.ts): notes, a screenshot, a data file. Exactly
// one of questionId / replyId is set. The bytes live in the row rather than in a bucket: there are few, each is small,
// and they go with their message. Past ATTACHMENT_RETENTION_DAYS the bytes are let go (data NULL) and the row stays, so
// an old thread still says what was sent.
model Attachment {
  id         String    @id @default(cuid())
  questionId String?
  replyId    String?
  name       String // the file name as sent, without its folders
  mimeType   String // from its bytes (an image, text), else as sent; what it is served as is decided again on the way out
  size       Int // bytes, kept when the bytes go
  data       Bytes?
  purgedAt   DateTime? // when the retention let the bytes go
  createdAt  DateTime  @default(now())

  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reply    Reply?    @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([replyId])
  @@index([createdAt])
  @@index([purgedAt, createdAt]) // the retention sweep: the files still held, oldest first
  @@map("attachments")
}

// A signed-in person's thumbs-up on a droplet on the public Droplets tab (routes/droplets.ts). One per person per
// droplet: the key is the pair, so liking twice is a no-op rather than a second row.
model DropletLike {
  answerId  String
  userId    String
  createdAt DateTime @default(now())

  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([answerId, userId])
  @@index([userId]) // a deleted user's likes go with them
  @@map("droplet_likes")
}

// A public comment on a droplet on the Droplets tab. Unlike a Reply it is not addressed to the teacher, and anyone
// can read it, signed in or not; it shows its author's name and picture, never their email or id.
model DropletComment {
  id             String   @id @default(cuid())
  answerId       String
  userId         String
  content        String // 1..1000 chars, plain text
  idempotencyKey String? // the Idempotency-Key it was posted with: a retried POST returns this comment instead of a second
  createdAt      DateTime @default(now())

  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([answerId, createdAt(sort: Desc), id(sort: Desc)]) // a droplet's comments, newest first, by cursor
  @@index([userId, createdAt]) // the hourly limit; a deleted user's comments go with them
  @@map("droplet_comments")
}

// A droplet's three videos, as its play counts name them.
enum DropletVideo {
  SONG
  LESSON
  HOOK // the upright hook cut
}

// How far the plays of each of a droplet's videos got, and how often its hook clip was shared and downloaded
// (routes/plays.ts): totals per droplet and video, nothing else. No row is a person, a device or a visit: no
// cookie, address, user id or time is kept with them, so they cannot say who watched, or when. A row is made by
// the first play counted; each bucket is kept at or below the one before it (started >= reached25 >= ... >=
// finished), so a count sent without the play before it moves nothing.
model DropletPlays {
  answerId   String
  video      DropletVideo
  started    Int          @default(0) // plays that started
  reached25  Int          @default(0) // of those, the ones that played at least a quarter of the video
  reached50  Int          @default(0)
  reached75  Int          @default(0)
  finished   Int          @default(0) // played at least 95% of it
  shared     Int          @default(0) // HOOK: the tile's Share went through (shared, or the link copied)
  downloaded Int          @default(0) // HOOK: the tile's Download pressed

  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@id([answerId, video])
  @@map("droplet_plays")
}

// A deleted droplet whose files are still to be cleared from R2 (api/src/lib/storage-delete.ts): written in the
// transaction that deletes the droplet, so its files go even when R2 does not answer at that moment. Kept until a
// sweep after the last upload URL signed for it has run out finds the job done, since a render still running when the
// learner deleted it can upload a file after the first pass. Only the id: nothing about the learner or the lesson, and
// no foreign key, as the answer is gone.
model StorageDeletion {
  answerId  String    @id
  createdAt DateTime  @default(now()) // when the droplet was deleted
  // When a pass last left both folders empty. Null: none has yet, or the last one failed. A sweep skips a row that is
  // cleared until its last pass is due (after SETTLE_MS), so each droplet costs two passes, not one an hour.
  clearedAt DateTime?
  tries     Int       @default(0) // passes that failed, for the log; a sweep takes the rows that failed least first
  lastError String? // why the last one did

  @@map("storage_deletions")
}

// Settings an admin changes on /admin/studio (api/src/lib/studio-settings.ts), one row per key, its value JSON. The
// studio reads them from its claims, so a change reaches the next run with no redeploy.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
