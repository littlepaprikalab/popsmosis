# Shared by api/ and web/ (both load the repo-root .env).

# Postgres. docker-compose.yml provides one at this URL for local dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/popsmosis
# Supabase (production): use the *Session pooler* URI from Project Settings >
# Database > Connection string (host aws-0-<region>.pooler.supabase.com, port
# 5432, user postgres.<project-ref>). Render has no IPv6, so the direct
# db.<ref>.supabase.co host will not connect from there; the pooler will.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional: a separate URL for migrations (defaults to DATABASE_URL). Set it to
# the Session pooler URI when DATABASE_URL is the transaction pooler (port 6543):
# migrations hang on that one.
# DIRECT_URL=

# Session cookie signing secret. Any long random string.
JWT_SECRET=change-me-to-a-random-secret

# Google OAuth (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI must be exactly GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Where the browser reaches the API (Next.js rewrites /api/* to this).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public URL of the API, substituted into the downloadable agent skill file.
API_BASE_URL=http://localhost:3001
# Public URL of the web app (used for OAuth redirects when set).
NEXT_PUBLIC_SITE_URL=

# Comma-separated browser origins allowed to call the API with cookies.
ALLOWED_ORIGINS=http://localhost:3000

# Production only: shared secret the Next.js proxy attaches to /api/* requests.
# When set, non-agent requests without it are refused.
# PROXY_SECRET=

# Emails that get the ADMIN role on sign-in (comma-separated). Anyone else with
# a Google account can sign in and use the site as a regular user. Put yourself
# here: somebody has to manage the agents. Adding an address later also reaches
# an account that is already signed in, on its next request.
ADMIN_EMAILS=

# How long the question queue's hand-out is leased to one agent, so two
# overlapping runs are given different questions instead of the same oldest
# five. Expires on its own, so a run that dies mid-answer cannot strand a
# question. Default 20; keep it above the longest studio step (the studio renews
# the claim before each one).
# QUESTION_CLAIM_MINUTES=20

# Wake the teacher on write (optional). When both are set, creating a question
# or posting a human reply fires the Claude Code routine's API trigger, so the
# teacher answers within seconds instead of at its next scheduled firing.
# The URL and token come from the routine's API trigger on claude.ai/code/routines;
# the token is shown once. Leave blank and the routine's schedule is the only
# thing that wakes it.
# POPSMOSIS_ROUTINE_FIRE_URL=https://api.anthropic.com/v1/claude_code/routines/<routine-id>/fire
# POPSMOSIS_ROUTINE_FIRE_TOKEN=
# Cooldown between fires, per API instance. Writes inside it collapse into one
# trailing fire when it ends. Default 300; 0 fires on every write; capped at 3600
# (a longer delay than setTimeout can hold would invert into firing every time).
# Keep it at or above how long one teacher run takes end to end. Below that, the
# trailing fire always wakes a second session while the first is still working.
# POPSMOSIS_ROUTINE_DEBOUNCE_SECONDS=300

# Days the files sent with questions and replies keep their bytes in Postgres
# (README "Attachments"). Past it the bytes go and the message still lists the
# file as expired. 0 keeps them for good.
# ATTACHMENT_RETENTION_DAYS=30

# Supabase Storage, for the droplet videos (docs/PLAN.md, section 10). The studio
# asks POST /api/answers/:id/upload-url for a signed URL and uploads straight to
# Supabase, so this key never leaves the API. Create two buckets by hand:
# "droplets" (public: the videos) and "studio" (private: art, audio, timings).
# Unset, the upload-url endpoint answers 503.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# A droplet whose videos say RENDERING but have not reported for this long reads
# as failed on the page: the routine's machine died with the render. Default 60.
# VIDEO_STALE_MINUTES=60

# How many times a droplet's videos are started in all: the first render, then a later run
# recovering one that died with its machine (GET /api/videos/queue). Default 2.
# VIDEO_MAX_ATTEMPTS=2
