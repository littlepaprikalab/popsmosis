# Every environment variable popsmosis reads, what it does, and the values it takes.
#
# Copy this file to .env at the repo root. api/ and web/ load that .env on their own
# (dev servers, scripts, the browser tests). The studio (python -m studio) and the
# teacher's skill-file commands do NOT read it: they use the shell's environment.
# Section 2 lists their variables so everything is documented in one place. On a
# Claude Code routine, set them in the routine environment's settings
# (docs/agent-runbook.md, section 1). On a laptop or cron runner, put them in their
# own file and export it, e.g. `set -a; . ./.env.agent; set +a`.
#
# How to read this file:
#   NAME=value      needed: replace the value with your own
#   # NAME=value    optional: unset means the default shown (or "off")
#
# A knob (README, "Knobs") can also be set by an admin on /admin/studio, so a change
# needs no redeploy: a value set there wins over the one here, and cleared there, the
# one here is read again. Each knob below says so.
#
# Keep every comment on its own line. web/ reads this file with a simple parser that
# keeps anything after the "=", so "NAME=value # note" would make " # note" part of
# the value. Leave an optional variable commented out rather than empty: some read an
# empty value as a setting, not as "use the default".


# =====================================================================================
# 1. The API (api/) and the web app (web/)
# =====================================================================================

# --- Database --------------------------------------------------------------------------

# Postgres. docker-compose.yml provides one at this URL for local dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/popsmosis

# Supabase (production): use the *Session pooler* URI from Project Settings >
# Database > Connection string (host aws-0-<region>.pooler.supabase.com, port
# 5432, user postgres.<project-ref>). Render has no IPv6, so the direct
# db.<ref>.supabase.co host will not connect from there; the pooler will.
# TLS is turned on for any host but localhost, 127.0.0.1, ::1 and db, or when
# the URL says sslmode=require; sslmode=disable turns it off. The server's
# certificate is checked (DATABASE_CA_CERT, below); sslmode=no-verify skips that.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# The database's CA certificate, as PEM text or the path to a file holding it. The API
# checks the certificate of any database not on this machine with it (Supabase signs its
# own: Project Settings > Database > SSL Configuration > Download certificate). Not needed
# for a local Postgres, nor for one whose certificate a public CA signed.
# DATABASE_CA_CERT=/etc/secrets/supabase-ca.crt

# Optional: a separate URL for migrations (defaults to DATABASE_URL). Set it to
# the Session pooler URI when DATABASE_URL is the transaction pooler (port 6543):
# migrations hang on that one.
# DIRECT_URL=

# Optional: how many Postgres connections each API instance keeps open. A whole
# number; default 5.
# DATABASE_POOL_SIZE=5

# --- Sign-in ---------------------------------------------------------------------------

# Session cookie signing secret. Any long random string. The API will not start
# without it, and the browser tests sign in with it, so they need the same value.
JWT_SECRET=change-me-to-a-random-secret

# Google OAuth (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI must be exactly GOOGLE_REDIRECT_URI. The NEXT_PUBLIC_
# pair is the same client id and redirect URI, for the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Emails that get the ADMIN role on sign-in (comma-separated, any case). Anyone
# else with a Google account can sign in and use the site as a regular user. Put
# yourself here: somebody has to manage the agents. Adding an address later also
# reaches an account that is already signed in, on its next request.
ADMIN_EMAILS=

# --- Where things are ------------------------------------------------------------------

# Where the browser reaches the API (Next.js rewrites /api/* to this). Default
# http://localhost:3001.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public URL of the API, substituted into the downloadable agent skill file.
# Default http://localhost:3001.
API_BASE_URL=http://localhost:3001
# Public URL of the web app, e.g. https://popsmosis.example. Used for OAuth
# redirects and page metadata when set; unset, the browser's own address.
NEXT_PUBLIC_SITE_URL=

# Comma-separated browser origins allowed to call the API with cookies. Default
# http://localhost:3000.
ALLOWED_ORIGINS=http://localhost:3000

# --- The server ------------------------------------------------------------------------

# Optional: the port the API listens on. Default 3001.
# PORT=3001

# Render sets this to production (render.yaml); leave it unset locally. In
# production the API requires PROXY_SECRET and sets the session cookie Secure.
# The test runner sets it to test.
# NODE_ENV=production

# Production only: shared secret the Next.js proxy attaches to /api/* requests.
# When set, non-agent requests without it are refused. Any long random string,
# the same on the API and the web app; render.yaml generates one.
# PROXY_SECRET=

# --- Limits ----------------------------------------------------------------------------

# Optional: topics one user may ask for in 24 hours. A whole number; default 10. Counted
# apart from the requests (api/src/lib/usage.ts), so taking one back or deleting it does not
# give its place back.
# Also a knob: an admin can set it on /admin/studio instead, which wins over this.
# QUESTIONS_PER_USER_PER_DAY=10

# Optional: topics everyone together may ask for in 24 hours: the ceiling on a day's model
# spend, at about $0.70 to $1 a droplet. A whole number; default 100; 0 for no ceiling.
# Also a knob: an admin can set it on /admin/studio instead, which wins over this.
# TOPICS_PER_DAY=100

# Optional: follow-ups one user may post in an hour. A whole number; default 30. Counted the
# same way: a deleted follow-up does not give its place back.
# Also a knob: an admin can set it on /admin/studio instead, which wins over this.
# REPLIES_PER_USER_PER_HOUR=30

# Optional: comments one user may post on the Droplets tab in an hour. A whole number;
# default 30. Likes are held to 60 a minute per user and need no setting.
# Also a knob: an admin can set it on /admin/studio instead, which wins over this.
# DROPLET_COMMENTS_PER_USER_PER_HOUR=30

# How long the question queue's hand-out is leased to one agent, so two
# overlapping runs are given different questions instead of the same oldest
# five. Expires on its own, so a run that dies mid-answer cannot strand a
# question. Minutes, a whole number above 0; default 20. Keep it above 5: the
# studio renews the claim before each step and every 5 minutes while one runs.
# Also a knob: an admin can set it on /admin/studio instead, which wins over this.
# QUESTION_CLAIM_MINUTES=20

# Days the files sent with questions and replies keep their bytes in Postgres
# (README "Attachments"). Past it the bytes go and the message still lists the
# file as expired. A whole number; default 30. 0 keeps them for good. The Privacy
# Policy states this number: change ATTACHMENT_RETENTION_DAYS in
# web/src/lib/legal.ts with it. The API lets them go on a schedule (every
# ATTACHMENT_SWEEP_MINUTES, default 60) and on the spot when one past its time is read.
# ATTACHMENT_RETENTION_DAYS=30
# ATTACHMENT_SWEEP_MINUTES=60

# The files each learner may send, in MB: a day (deleting a request gives none back),
# and held at a time (deleting a request frees its files). Whole numbers; 0 for no limit.
# Without them one account could add about 240 MB an hour to Postgres.
# Also knobs: an admin can set them on /admin/studio instead, which wins over these.
# ATTACHMENT_MB_PER_USER_PER_DAY=20
# ATTACHMENT_MB_HELD_PER_USER=60

# --- Waking the teacher ----------------------------------------------------------------

# Wake the teacher on write (optional). When both are set, creating a question
# or posting a human reply fires the Claude Code routine's API trigger, so the
# teacher answers within seconds instead of at its next scheduled firing.
# The URL and token come from the routine's API trigger on claude.ai/code/routines;
# the token is shown once. Leave blank and the routine's schedule is the only
# thing that wakes it.
# POPSMOSIS_ROUTINE_FIRE_URL=https://api.anthropic.com/v1/claude_code/routines/<routine-id>/fire
# POPSMOSIS_ROUTINE_FIRE_TOKEN=

# Cooldown between fires, per API instance. Writes inside it collapse into one
# trailing fire when it ends. Seconds; default 300; 0 fires on every write; capped
# at 3600 (a longer delay than setTimeout can hold would invert into firing every
# time). Keep it at or above how long one teacher run takes end to end. Below that,
# the trailing fire always wakes a second session while the first is still working.
# Also a knob: an admin can set it on /admin/studio instead, which wins over this.
# POPSMOSIS_ROUTINE_DEBOUNCE_SECONDS=300

# Optional: the beta header the routine's fire endpoint is called with, so a new
# header version can be rolled forward without a code change.
# Also a knob: an admin can set it on /admin/studio instead, which wins over this.
# POPSMOSIS_ROUTINE_BETA=experimental-cc-routine-2026-04-01

# --- The droplet videos ----------------------------------------------------------------

# Cloudflare R2, for the droplet videos (docs/PLAN.md, section 10). The studio asks
# POST /api/answers/:id/upload-url for a signed URL and uploads straight to R2, so the
# key never leaves the API. Two buckets, made by hand: "droplets" (public through its
# custom domain: the videos and posters) and "studio" (private: art, audio, timings);
# docs/DEPLOY.md, section 6, has the steps. Set all four or none: unset, the upload-url
# endpoint answers 503. Local development does not need them: seed:dev's videos are
# web/public/samples/.
# R2_ACCOUNT_ID: the 32-character account ID (R2 > Overview > Account Details).
# R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY: the pair shown once when an R2 API token is
# made (R2 > Overview > API Tokens > Manage; Object Read & Write on the two buckets), not
# the token's own value.
# R2_PUBLIC_URL: the droplets bucket's custom domain, with no path.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://media.popsmosis.com
# Only while moving off Supabase Storage (docs/DEPLOY.md, section 6, "Videos made before the
# move"): the old project's URL, so a render that spans the switch can still report its files
# there. Remove it once the API's log shows every droplet moved.
# SUPABASE_URL=https://<project-ref>.supabase.co

# A droplet whose videos say RENDERING but have not reported for this long reads
# as failed on the page: the routine's machine died with the render. Minutes, a
# whole number above 0; default 60.
# Also a knob: an admin can set it on /admin/studio instead, which wins over this.
# VIDEO_STALE_MINUTES=60

# How long after a lesson is posted /learn holds its text back for its videos; until then
# the card shows the droplet's bill filling in. Minutes; default 0: the text shows as soon
# as the lesson is posted.
# Also a knob: an admin can set it on /admin/studio instead, which wins over this.
# LESSON_HOLD_MINUTES=20

# How many times a droplet's videos are started in all: the first render, then a later run
# recovering one that died with its machine (GET /api/videos/queue). A whole number
# above 0; default 2.
# Also a knob: an admin can set it on /admin/studio instead, which wins over this.
# VIDEO_MAX_ATTEMPTS=2


# =====================================================================================
# 2. The teacher and the studio (python -m studio): NOT read from this file
# =====================================================================================
# Set these where the teacher runs (see the top of this file).

# --- popsmosis -------------------------------------------------------------------------

# Where the API is, the same value as its API_BASE_URL, and the teacher's agent key
# (sk_pop_..., from the AGENTS admin page or `npm --workspace api run agent:create`).
# POPSMOSIS_API_URL=http://localhost:3001
# POPSMOSIS_API_KEY=sk_pop_...

# --- The brain and the art: only their keys ------------------------------------------

# The environment holds only the keys. The default brain, Claude's effort and who paints
# each brain's pictures are chosen by an admin on /admin/studio (README, "Choosing the
# models"). BRAIN_PROVIDER, STUDIO_BRAIN_MODEL and STUDIO_BRAIN_EFFORT are no longer read:
# while one is still set, the studio stops and says to remove it.

# For Claude's brain and its picture checks: an Anthropic API key. Its calls bill per token
# to that API account. ANTHROPIC_API_KEY works too, but a Claude Code cloud environment does
# not pass a variable of that name through, hence this one.
# POPSMOSIS_ANTHROPIC_API_KEY=sk-ant-...

# For a Muse brain, and for the art with either brain: the Meta API key (dev.meta.ai), for every
# Meta model the studio calls: Muse Wonder and Muse Spark (the brain and the helper, per
# token), Muse Image ($0.01 a picture) and SAM 3.1 ($2.50 per 1,000 images), which finds
# the structures in a painted picture whoever painted it.
# MODEL_API_KEY=

# When Gemini 3.1 Flash Image paints the art (the default for Claude's brain, about $0.07
# a picture), the studio needs GEMINI_API_KEY: it is set below, with the songs.

# --- The audio: the song, the narration, the exam question -----------------------------

# Who sings the song, ElevenLabs' Eleven Music or Lyria on the Gemini API, is picked on
# /admin/studio, not here: SONG_PROVIDER is no longer read, and while it is still set the
# studio stops and says to remove it. The narration is ElevenLabs either way.

# The narration and the exam question read aloud, and the song unless Lyria sings it.
# Its calls bill to that ElevenLabs account.
# ELEVENLABS_API_KEY=

# Optional: the narration's voice, any ElevenLabs voice id. Default
# Xb7hH8MSUJpSbSDYk0k2 (Alice; studio/steps/audio.py, DEFAULT_VOICE).
# Also a knob: an admin can set it on /admin/studio instead, which wins over this.
# ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2

# Optional: what 1,000 ElevenLabs credits cost on your plan, in US dollars (e.g. 0.30),
# so the ElevenLabs lines of a droplet's bill of materials show dollars as well as
# credits. Unset, they show credits only.
# Also a knob: an admin can set it on /admin/studio instead, which wins over this.
# ELEVENLABS_USD_PER_1K_CREDITS=0.30

# When Lyria sings the song or Gemini 3.1 Flash Image paints the art: a Gemini API
# key from Google AI Studio, on a paid tier (Lyria has no free tier; $0.08 a song).
# GEMINI_API_KEY=

# When Lyria sings: the Lyria model. Default lyria-3.5 (full songs);
# lyria-3-clip-preview makes 30-second clips ($0.04).
# Also a knob: an admin can set it on /admin/studio instead, which wins over this.
# GEMINI_SONG_MODEL=lyria-3.5

# --- The videos ------------------------------------------------------------------------

# off (or 0, false, no) makes text-only droplets: no video claim, no media steps,
# no recovery. Unset or anything else, the videos are made.
# Also a knob: an admin can set it on /admin/studio instead, which wins over this.
# STUDIO_VIDEOS=off

# Optional: how many processes render a video's frames in parallel. A whole
# number; default the machine's CPU count.
# STUDIO_RENDER_WORKERS=4

# Optional: where the studio keeps its jobs. A folder path; default jobs/ at the
# repo root.
# STUDIO_JOBS_DIR=

# --- Inkmory: the operator's public record (docs/PLAN.md, section 11) -------------------

# The operator keeps its record when both the URL and its key are set.
# INKMORY_API_URL=https://inkmory.com
# INKMORY_OPERATOR_API_KEY=sk_inkmory_...

# false turns Inkmory off and leaves everything else as it is. Unset or anything
# else, it is on when the two above are set.
# INKMORY_ENABLED=false

# The web app: Inkmory's site, for the "Teacher's notes" link on each lesson card,
# which opens Inkmory's search for the topic's tag (popsmosis:<topic id>). Built into
# the page; unset, there is no link.
# NEXT_PUBLIC_INKMORY_URL=https://inkmory.com

# The web app: the API's R2_PUBLIC_URL, the one host besides the site that pages load the
# droplet videos and posters from (its Content-Security-Policy). Built into the page; unset,
# media loads from the site alone, as the seeded sample droplets do. NEXT_PUBLIC_SUPABASE_URL
# adds the old Supabase project, only while the API's boot log says a droplet still plays from it.
# NEXT_PUBLIC_MEDIA_URL=https://media.popsmosis.com
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co


# =====================================================================================
# 3. Tests only
# =====================================================================================

# 1 also runs the API's integration tests against DATABASE_URL
# (`INTEGRATION=1 npm --workspace api test`). Unset, they are skipped.
# INTEGRATION=1

# Where the browser tests find the web app and the API (`npm run e2e`). Defaults
# http://localhost:3000 and http://localhost:3001.
# E2E_BASE_URL=http://localhost:3000
# E2E_API_URL=http://localhost:3001

# 1 runs the studio's live audio checks (studio/tests/test_live_audio.py), which
# spend ElevenLabs credits and, with GEMINI_API_KEY, one Lyria song. Unset, they
# are skipped.
# STUDIO_LIVE_AUDIO=1


# =====================================================================================
# 4. Set for you: do not set these by hand
# =====================================================================================
# ROLE                       set by `npm --workspace api run user:promote` / `user:demote`
# POPSMOSIS_RENDER_PARENT    set by the renderer for its worker processes
# PYTHONPATH                 extended by the renderer for its worker processes
# CI, GITHUB_ACTIONS         set by GitHub Actions; the tests report for it (and the
#                            browser tests retry once)
# CLAUDE_CODE_REMOTE, CLAUDE_PROJECT_DIR, CLAUDE_ENV_FILE
#                            set by Claude Code cloud sessions for the session-start hook
